# Copia este archivo a .env.local y rellena los valores.
# .env y .env.* están en .gitignore: la anon key no se versiona.

# Backend de Proxant (Supabase self-hosted). En local, Kong escucha en 8000.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=

# Sólo para desarrollo del modo real. En producción la clave la entrega el
# backend dentro de la sesión de escaneo; no se hornea en el bundle.
# VITE_SHENAI_API_KEY=
